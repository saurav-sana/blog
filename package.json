{
  "name": "architecture-blog",
  "version": "1.0.0",
  "description": "Static GitHub Pages blog with local validation",
  "scripts": {
    "start": "browser-sync start --server --files '**/*.html, assets/css/*.css, assets/js/*.js'",
    "lint:html": "htmlhint '**/*.html'",
    "lint:css": "stylelint 'assets/css/**/*.css'",
    "validate": "npm run lint:html && npm run lint:css",
    "prepare": "husky install"
  },
  "devDependencies": {
    "browser-sync": "^2.29.3",
    "htmlhint": "^1.1.4",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "stylelint": "^15.10.1",
    "stylelint-config-standard": "^34.0.0"
  },
  "lint-staged": {
    "**/*.html": "htmlhint",
    "assets/css/**/*.css": "stylelint"
  }
}
