      "57": {
        "chunkId": "93a3ad",
        "hash": "7570f922",
        "encoded": "%3Cp%3ETraffic%20does%20not%20arrive%20uniformly.%20It%20arrives%20in%20bursts%20governed%20by%20the%20Poisson%20process%20%E2%80%94%20and%20the%20gap%20between%20the%20average%20arrival%20rate%20and%20the%20peak%20burst%20rate%20is%20where%20most%20capacity%20plans%20silently%20fail.%20When%20a%20system%20is%20pushed%20past%2085%25%20utilization,%20Kingman%E2%80%99s%20heavy-traffic%20approximation%20shows%20that%20queue%20wait%20time%20does%20not%20grow%20linearly:%20it%20diverges%20toward%20infinity.%3C/p%3E",
        "prevChunkIds": []
      },
